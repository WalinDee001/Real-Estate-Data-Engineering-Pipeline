DROP TABLE IF EXISTS gold_housing_api;
CREATE TABLE gold_housing_api(
	property_id bigint,
    listing_id bigint,
    status nvarchar(30),
    3D_virtual_tour nvarchar(20),
    list_price decimal(15,2),
    discount decimal(15,2),
    discounted_list_price decimal(15,2),
    last_sold_date date,
    last_sold_year year,
    housing_price_index float,
    list_date date,
    last_sold_price decimal(15,2),
    nominal_profit decimal(15,2),
    inflation_adjusted_profit decimal(15,2),
    nominal_ROI_percentage decimal(15,2),
    inflated_adjusted_ROI_percentage decimal(15,2),
    property_city nvarchar(50),
    property_address nvarchar(300),
    property_type nvarchar(50),
    number_of_bedrooms int,
    number_of_bathrooms int,
    property_newly_listed text,
    source_listing_id nvarchar(30),
    advertiser_name nvarchar(200),
    advertiser_email nvarchar(300),
	company_name nvarchar(300)
);
