select pet_policy_cats,
case 
when pet_policy_cats = 1 then "YES"
when pet_policy_cats = 0 then "NO"
else "N/A"
end as pet_policy_cats
from bronze_housing_api;


select list_price,
case
when price_reduced_amount is null then 0
else price_reduced_amount
end as price_reduced_amount,
coalesce(list_price,0) - coalesce(price_reduced_amount,0)  as listing_price_with_discount 
from bronze_housing_api;


select last_sold_date, 
case
when last_sold_date is null then "N/A"
else substring(last_sold_date,1,4)
end as last_sold_year 
from bronze_housing_api;


select distinct last_sold_year
from(
	select  
	case
		when last_sold_date is null then "N/A"
		else substring(last_sold_date,1,4)
		end as last_sold_year 
	from bronze_housing_api
)t
order by last_sold_year asc;

select last_sold_price, list_price, last_sold_date, last_sold_year, housing_price_index,
	list_price - last_sold_price as nominal_profit,
	list_price - ((557.38/housing_price_index) * last_sold_price) as inflation_adjusted_profit,
    ((list_price - ((557.38/housing_price_index) * last_sold_price)) / ((557.38/housing_price_index) * last_sold_price)) * 100 as inflated_adjusted_ROI,
    ((list_price - last_sold_price) / last_sold_price) * 100 as nominal_ROI
    
from(
	select last_sold_price, list_price, last_sold_date,
	case
		when last_sold_date is null then "N/A"
		else substring(last_sold_date,1,4)
